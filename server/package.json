{
  "name": "offlinepay-backend",
  "version": "1.0.0",
  "description": "OfflinePay API Server",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node --esm src/app.ts",
    "build": "tsc && node ./scripts/verify-build.mjs",
    "start": "node dist/app.js",
    "migrate": "ts-node --esm migrations/run.ts"
  },
  "keywords": [
    "celo",
    "crypto",
    "payments",
    "offline",
    "webauthn"
  ],
  "author": "OfflinePay Team",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "9.0.3",
    "cors": "2.8.5",
    "decimal.js": "10.4.3",
    "dotenv": "16.3.1",
    "ethers": "6.10.0",
    "express": "4.18.2",
    "express-rate-limit": "7.1.5",
    "google-auth-library": "^9.15.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.0",
    "pg": "8.11.3",
    "qrcode": "1.5.3",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.2",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
